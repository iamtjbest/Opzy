# Node / Next.js
node_modules/
.next/
out/

# Python / FastAPI
__pycache__/
*.pyc
.venv/
venv/

# Env — real secrets never get committed.
.env
.env.local
*.env
# Anything suffixed onto .env too: .env.backup, .env.production, .env.save and friends.
# `*.env` above only catches names *ending* in .env, so .env.backup slipped through.
.env.*
# ...except the checked-in templates, which carry no secrets.
!.env.example

# Editor / OS
.DS_Store
.vscode/

# Planning docs are kept local, not versioned.
docs/ROADMAP.md
docs/sprints/
docs/superpowers/

# Claude Code working agreements are kept local, not versioned.
CLAUDE.md
