# Local Postgres from docker-compose.yml (run: docker compose up -d).
# Port 55432, because a system Postgres may already be using 5432.
DATABASE_URL=postgresql://opzy:opzy_local_dev@127.0.0.1:55432/opzy

# To use Supabase instead, replace the line above with the connection string from
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the direct connection (port 5432) locally; the pooled one (6543) for deploys.
# Paste it as-is — `sslmode` is translated to asyncpg's `ssl` automatically.

# Comma-separated origins allowed to call this API. The Next.js dev server is :3000.
CORS_ORIGINS=http://localhost:3000

# development | production
ENVIRONMENT=development

# Signs access tokens. Required. Must be 32+ characters in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set to true to log every SQL statement. Verbose — off by default.
SQL_ECHO=false

# How email is sent. console (the default) only logs each email, for development.
# resend sends through Resend (https://resend.com) and is required when deployed.
EMAIL_BACKEND=console
# Needed when EMAIL_BACKEND=resend. EMAIL_FROM's domain must be verified in Resend,
# e.g. EMAIL_FROM=Opzy <hello@opzy.app>
RESEND_API_KEY=
EMAIL_FROM=

# The frontend's base URL. Links in emails point here.
FRONTEND_URL=http://localhost:3000
